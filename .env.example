# docker-compose 용 환경변수 예시. 복사해서 .env 로 만들고 값 채우기.
#   cp .env.example .env
# .env 는 절대 커밋하지 마세요 (.gitignore 에 포함됨).

# --- PostgreSQL (Neon / Supabase 등 무료 클라우드 DB) ---
# Neon 대시보드의 연결 문자열을 JDBC 형식으로 변환해서 넣으세요:
#   postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#   → DATABASE_URL=jdbc:postgresql://ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#   → DATABASE_USERNAME=USER,  DATABASE_PASSWORD=PASS  (URL 에서 분리)
DATABASE_URL=jdbc:postgresql://ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_USERNAME=your-db-user
DATABASE_PASSWORD=your-db-password

# --- 네이버 검색 API ---
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# --- Google Gemini (예비 모델) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Anthropic Claude (주 모델) ---
# 비워 두면 Claude 를 건너뛰고 Gemini 로만 분석한다 (서비스는 멈추지 않는다).
ANTHROPIC_API_KEY=

# --- AI 분석 모델 체인 (선택) ---
# "제공자:모델" 쉼표 목록, 앞에서부터 시도하고 실패하면 다음으로 넘어간다. 제공자는 claude 또는 gemini.
# 비워 두거나 형식이 틀리면 기본값을 쓴다: claude:claude-haiku-5-5,gemini:gemini-3.5-flash-lite
ANALYSIS_MODELS=

# 기사 본문 수집 (언론사 원문에서 본문 앞부분을 가져와 분석 입력으로 사용). 끄려면 false
NEWS_BODY_ENABLED=true
NEWS_ALIASES_ENABLED=true

# --- 관리용 API 토큰 ---
# POST /api/stocks/refresh, POST /api/archive/run 호출 시 X-Admin-Token 헤더로 보내야 하는 값.
# 추측하기 어려운 긴 임의 문자열을 직접 생성해 넣으세요. 비워 두면 두 API 는 차단됩니다(403).
ADMIN_TOKEN=

# --- CORS (선택) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app
