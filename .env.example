# docker-compose 용 환경변수 예시. 복사해서 .env 로 만들고 값 채우기.
#   cp .env.example .env
# .env 는 절대 커밋하지 마세요 (.gitignore 에 포함됨).

# --- PostgreSQL (Neon / Supabase 등 무료 클라우드 DB) ---
# Neon 대시보드의 연결 문자열을 JDBC 형식으로 변환해서 넣으세요:
#   postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#   → DATABASE_URL=jdbc:postgresql://ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
#   → DATABASE_USERNAME=USER,  DATABASE_PASSWORD=PASS  (URL 에서 분리)
DATABASE_URL=jdbc:postgresql://ep-xxx.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_USERNAME=your-db-user
DATABASE_PASSWORD=your-db-password

# --- 네이버 검색 API ---
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key

# --- CORS (선택) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app
